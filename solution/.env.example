OPENAI_API_KEY=your-key-here
# Only if you use an OpenAI-compatible proxy (e.g. Vocareum):
# OPENAI_BASE_URL=https://openai.vocareum.com/v1
# Optional overrides
# UDAHUB_CHAT_MODEL=gpt-4o-mini
# UDAHUB_RESOLUTION_MIN_CONFIDENCE=0.7

# Model provider: openai (default) or bedrock
# UDAHUB_LLM_PROVIDER=bedrock
# For Bedrock, use any standard AWS credentials (a profile, SSO, or these variables):
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# Optional: override the Bedrock models
# UDAHUB_CHAT_MODEL=us.anthropic.claude-3-5-haiku-20241022-v1:0
# UDAHUB_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Embeddings from a SageMaker endpoint instead (see deploy/sagemaker_embeddings.py)
# UDAHUB_EMBEDDING_PROVIDER=sagemaker
# UDAHUB_SAGEMAKER_ENDPOINT=udahub-embeddings
# SAGEMAKER_ROLE_ARN=arn:aws:iam::<account-id>:role/<sagemaker-execution-role>

# Optional: Langfuse tracing of every graph run (prompts, responses, tokens, tool calls).
# Off unless both keys are set. To use the Langfuse started with service/docker-compose.yml
# (--profile langfuse), copy the two keys from service/.env:
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=http://localhost:3001
