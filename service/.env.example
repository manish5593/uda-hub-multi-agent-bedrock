# Copy to service/.env (git ignores it) and replace every value.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# Keys that clients send to the gateway in the X-API-Key header (comma-separated, one per integration)
GATEWAY_API_KEYS=change-me-web-chat-key
GATEWAY_RATE_LIMIT_PER_MINUTE=30
GATEWAY_PORT=8080

# Shared secret between the services (header X-Internal-Token)
INTERNAL_API_TOKEN=change-me-internal-token

# Postgres superuser, and one role per service database (letters and digits only)
POSTGRES_PASSWORD=change-me-postgres
CULTPASS_DB_PASSWORD=change-me-cultpass
TICKETS_DB_PASSWORD=change-me-tickets
KNOWLEDGE_DB_PASSWORD=change-me-knowledge
AGENT_STATE_DB_PASSWORD=change-me-agent-state

LOG_LEVEL=INFO
