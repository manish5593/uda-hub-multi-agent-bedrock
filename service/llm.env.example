# Copy to service/llm.env (git ignores it). Only the agent and knowledge services receive these.
# Same settings as solution/.env.example: see agentic/config.py.

# --- OpenAI (default) ---
UDAHUB_LLM_PROVIDER=openai
OPENAI_API_KEY=your-key-here
# Only for an OpenAI-compatible proxy (e.g. Vocareum):
# OPENAI_BASE_URL=https://openai.vocareum.com/v1

# --- Amazon Bedrock ---
# UDAHUB_LLM_PROVIDER=bedrock
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# UDAHUB_CHAT_MODEL=us.anthropic.claude-3-5-haiku-20241022-v1:0
# UDAHUB_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# --- Embeddings from a SageMaker endpoint (knowledge service) ---
# UDAHUB_EMBEDDING_PROVIDER=sagemaker
# UDAHUB_SAGEMAKER_ENDPOINT=udahub-embeddings
