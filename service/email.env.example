# Copy to service/email.env (git ignores it) to email the one-time codes instead of logging them.
# Only the auth and agent services receive these. See solution/agentic/mailer.py.

# "log" (default): codes are written to the service logs. "ses": sent with Amazon SES.
UDAHUB_EMAIL_PROVIDER=ses
# The sender: an email address (or a domain) verified in SES
UDAHUB_EMAIL_FROM=support@example.com
# If SES fails, log the code so a demo can go on. Set to false in production.
UDAHUB_EMAIL_LOG_FALLBACK=true

# AWS credentials of a user allowed ses:SendEmail, and the SES region
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
